{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/asesor-financiero-registrado-cnmv",
      "destination": "/preguntas-a-un-asesor-financiero-antes-de-contratarlo",
      "permanent": true
    },
    {
      "source": "/asesor-financiero-registrado-cnmv.html",
      "destination": "/preguntas-a-un-asesor-financiero-antes-de-contratarlo",
      "permanent": true
    },
    {
      "source": "/asesor-financiero-registrado-cnmv-gl",
      "destination": "/preguntas-a-un-asesor-financiero-antes-de-contratarlo-gl",
      "permanent": true
    },
    {
      "source": "/asesor-financiero-registrado-cnmv-gl.html",
      "destination": "/preguntas-a-un-asesor-financiero-antes-de-contratarlo-gl",
      "permanent": true
    }
  ]
}
